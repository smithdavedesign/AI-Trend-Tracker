# Neon Postgres
# Use the pooled connection string for production (Settings → Connection pooling in Neon console)
# Pooled:    postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Direct:    postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Anthropic (Claude)
ANTHROPIC_API_KEY=your-anthropic-key

# Inngest
# Dev: leave INNGEST_DEV=1, no keys needed
# Prod: get keys from app.inngest.com → your function → Manage → Keys
INNGEST_DEV=1
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key

# Resend (email digest) — free tier: 100 emails/day, 3000/month
# Get key at resend.com → API Keys
RESEND_API_KEY=your-resend-key
# From address — use onboarding@resend.dev for testing (no domain needed)
# For production: verify your domain at resend.com/domains and set e.g. "AIRadar <digest@yourdomain.com>"
RESEND_FROM=AIRadar <onboarding@resend.dev>

# GitHub API (raises rate limit from 60 to 5000 req/hr)
# Create at github.com/settings/tokens → Fine-grained token → public repos read-only
GITHUB_TOKEN=your-github-token

# Product Hunt crawler (optional)
# Create at producthunt.com/v2/oauth/applications → Developer Token
PRODUCT_HUNT_TOKEN=your-ph-token

# Revalidation secret (for on-demand ISR cache busting)
REVALIDATION_SECRET=your-revalidation-secret

# Admin dashboard password
ADMIN_PASSWORD=your-admin-password

# Public site URL (used in OG images, feeds, and digest emails)
NEXT_PUBLIC_SITE_URL=https://aidar.vercel.app
